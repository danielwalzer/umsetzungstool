# =============================================================================
# Umsetzungstool – Environment Variables
# =============================================================================
# Kopiere diese Datei nach .env und befülle alle Werte. .env ist gitignored.
# Co-Work beschafft die Werte während des Setups in den jeweiligen UIs.
# =============================================================================


# -----------------------------------------------------------------------------
# SeaTable Cloud
# -----------------------------------------------------------------------------
# Base-URL der SeaTable-Cloud-Instanz. Ohne trailing slash.
SEATABLE_BASE_URL=https://cloud.seatable.io

# Base-API-Token der Base "Umsetzungs-Tracking".
# Anlegen in SeaTable: Base öffnen → ... → API Tokens → "n8n" anlegen,
# Permission: read-write. Token einmalig kopieren, wird nicht erneut angezeigt.
SEATABLE_API_TOKEN=

# Base-Identifikation. Werden für direkte HTTP-Calls über das API-Gateway
# gebraucht (z.B. Notes-Engagement, Subject-Updates). Sind keine Secrets,
# stehen aus Bequemlichkeit hier statt in der seatable-schema.json.
SEATABLE_BASE_UUID=36f34c52-dcdd-49a6-b414-976465d26ee4
SEATABLE_WORKSPACE_ID=83657
SEATABLE_API_GATEWAY=https://cloud.seatable.io/api-gateway/


# -----------------------------------------------------------------------------
# HubSpot
# -----------------------------------------------------------------------------
# Private-App-Token mit reduzierten Scopes (Notes-Strategie statt Custom
# Properties — siehe setup/hubspot-note-template.md):
#   - crm.objects.contacts.read
#   - crm.objects.contacts.write
#   - crm.objects.notes.write
# Anlegen: HubSpot → Settings → Integrations → Private Apps → Create.
HUBSPOT_PRIVATE_APP_TOKEN=


# -----------------------------------------------------------------------------
# n8n (selbst gehostet)
# -----------------------------------------------------------------------------
# Basis-URL der n8n-Instanz, z.B. https://n8n.result.de. Ohne trailing slash.
N8N_BASE_URL=

# Webhook-URL des Workflows "Get Active Workshops" (HTTP GET).
# Wird vom Webform aufgerufen, um das Workshop-Dropdown zu befüllen.
# Liefert JSON-Array aus SeaTable Workshops mit Status=active.
N8N_GET_WORKSHOPS_URL=

# Webhook-URL des Workflows "Submit Form" (HTTP POST).
# Empfängt Webform-JSON, schreibt Submission in SeaTable, legt
# ScheduledEmails an, upsertet Kontakt in HubSpot und hängt eine Note an.
N8N_SUBMIT_URL=


# -----------------------------------------------------------------------------
# MS Graph (zentrale Mailbox umsetzung@result.de)
# -----------------------------------------------------------------------------
# Azure-Tenant-ID von result.
MS_GRAPH_TENANT_ID=

# Client-ID der Azure-App-Registration "Umsetzungstool Mailer".
# Anlegen in Azure Portal → App registrations → New registration.
MS_GRAPH_CLIENT_ID=

# Client-Secret der App-Registration. NICHT verwechseln mit Client-ID.
# Wird einmalig nach Anlage angezeigt, danach nicht mehr lesbar.
MS_GRAPH_CLIENT_SECRET=

# Zentrale Versand-Mailbox. Die App-Registration braucht Application-Permission
# Mail.Send (Admin-Consent erforderlich), idealerweise per
# ApplicationAccessPolicy auf genau diese Mailbox eingeschränkt.
MS_GRAPH_MAILBOX=umsetzung@result.de


# -----------------------------------------------------------------------------
# Benachrichtigungen bei Fehlern
# -----------------------------------------------------------------------------
# Incoming-Webhook (Microsoft Teams oder Slack), an den n8n bei
# fehlgeschlagenen E-Mail-Versendungen oder API-Errors postet.
# Leer lassen = keine Push-Benachrichtigungen, Fehler nur in SeaTable
# ScheduledEmails.ErrorMessage und n8n-Execution-Log sichtbar.
NOTIFY_WEBHOOK=
